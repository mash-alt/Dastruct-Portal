              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"studentId\": \"{{studentId}}\",\n    \"subjectIds\": [\"{{subjectId1}}\", \"{{subjectId2}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/subjects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "subjects"
              ]
            },
            "description": "Add subjects to a student's enrolled subjects (without changing enrollment status)"
          },
          "response": []
        }
