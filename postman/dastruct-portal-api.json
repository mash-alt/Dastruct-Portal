        {
          "name": "Enroll Student in Subjects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"studentId\": \"{{studentId}}\",\n    \"subjectIds\": [\"{{subjectId1}}\", \"{{subjectId2}}\"],\n    \"academicYear\": \"2025-2026\",\n    \"semester\": \"First\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/student/enroll",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "student",
                "enroll"
              ]
            },
            "description": "Enroll a student in subjects for current academic period"
          },
          "response": []
        },
        {
          "name": "Add Subjects (without enrollment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              },
              {
                "key": "Content-Type",
