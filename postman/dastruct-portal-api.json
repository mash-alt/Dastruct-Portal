  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Student Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test Student\",\n    \"email\": \"test.student@example.com\",\n    \"password\": \"123\",\n    \"studentId\": \"STUD-2025-001\",\n    \"bday\": \"2004-05-13T00:00:00.000Z\",\n    \"idNumber\": \"2025-00001\",\n    \"course\": \"BSIT\",\n    \"yearLevel\": 1,\n    \"section\": \"A\",\n    \"address\": \"123 University Boulevard, Manila\",\n    \"phoneNumber\": \"09123456789\",\n    \"department\": \"BSIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/student/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "student",
                "signup"
              ]
            },
            "description": "Register a new student"
          },
          "response": []
        },
        {
          "name": "Student Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test.student@example.com\",\n    \"password\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/student/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "student",
                "login"
              ]
            },
            "description": "Login as a student"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    },
    {
      "name": "Academic",
      "item": [
        {
          "name": "Get Academic Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/academic/{{studentId}}/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "academic",
                "{{studentId}}",
                "progress"
              ]
            },
            "description": "Get a student's academic progress"
          },
          "response": []
        },
        {
          "name": "Record Grades",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"academicYear\": \"2025-2026\",\n    \"semester\": \"First\",\n    \"grades\": [\n        {\n            \"edpCode\": \"CS101\",\n            \"midtermGrade\": 1.75,\n            \"finalGrade\": 1.5\n        },\n        {\n            \"edpCode\": \"MATH101\",\n            \"midtermGrade\": 2.0,\n            \"finalGrade\": 1.75\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/academic/{{studentId}}/grades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "academic",
                "{{studentId}}",
                "grades"
              ]
            },
            "description": "Record grades for a student (teacher only)"
          },
          "response": []
        },
        {
          "name": "Simulate Academic Progression",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacherToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"studentId\": \"{{studentId}}\",\n    \"semesters\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/academic/simulate-progression",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "academic",
                "simulate-progression"
              ]
            },
            "description": "Simulate a student's academic progression (teacher/admin only)"
          },
          "response": []
        }
      ],
      "description": "Academic endpoints"
    },
